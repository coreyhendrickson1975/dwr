---
import Layout from '../layouts/Layout.astro';
import { SignupForm } from '../components/SignupForm';
import { SceneSample } from '../components/SceneSample';

const lastAdventureThumbnail = '/lastadventurethumb.jpg';
---

<Layout>
  <main class="min-h-screen bg-background text-foreground">

    <!-- Hero Section -->
    <section class="px-6 pt-24 pb-16 md:pt-32 md:pb-20">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-xs uppercase tracking-widest text-muted-foreground mb-6">
          A new documentary by Corey Hendrickson
        </p>
        <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-light tracking-tight text-foreground uppercase">
          Distance We Run
        </h1>
        <p class="mt-12 text-lg md:text-xl text-muted-foreground font-light max-w-2xl mx-auto leading-relaxed text-balance">
          Grieving his son's overdose death, a Vermont father channels his pain into ultrarunning to generate support and raise awareness for those in recovery.
        </p>
      </div>
    </section>

    <!-- Signup Section -->
    <section class="px-6 md:px-12 lg:px-24 py-20 md:py-28 border-t border-border">
      <div class="max-w-md mx-auto text-center">
        <h2 class="font-serif text-2xl md:text-3xl font-light text-foreground mb-3">
          Stay Updated
        </h2>
        <p class="text-sm text-muted-foreground mb-8">
          Be the first to know about screenings and release dates
        </p>
        <SignupForm client:load />
      </div>
    </section>

    <!-- Scene Samples Section -->
    <section class="px-6 md:px-12 lg:px-24 py-20 md:py-28 border-t border-border">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16">
          <h2 class="font-serif text-2xl md:text-3xl font-light text-foreground">
            Scene Samples
          </h2>
          <p class="mt-3 text-sm text-muted-foreground">
            Password-protected previews for development and PR — may undergo changes for the final cut
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 items-start">
          <SceneSample
            client:load
            sceneNumber={1}
            title="Body Work"
            duration="3:42"
            description="As the training miles pile up, Chip visits his chiropractor to keep his body in line with the demands of the long road ahead."
            thumbnailUrl="/chiro.jpg"
          />
          <SceneSample
            client:load
            sceneNumber={2}
            title="The Last Adventure"
            duration="7:25"
            description="Michael's friend Dan recalls their last adventure together, a hike along Vermont's Long Trail."
            videoUrl="https://coreyhendrickson.wistia.com/s/da413qzeuvmhmia"
            thumbnailUrl={lastAdventureThumbnail}
          />
          <SceneSample
            client:load
            sceneNumber={3}
            title="A Different Way Forward"
            duration="4:07"
            description="Inside Ben's House, we see how the funds Chip raised are giving people in recovery a healthy path to a new life."
            thumbnailUrl="/bens.jpg"
          />
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-12 border-t border-border">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm text-muted-foreground">
          ©2026 Distance We Run - All Rights Reserved
        </p>
      </div>
    </footer>

  </main>
</Layout>
